# Settings of the production environment on the app VM: copy to /etc/ht-xas/prod.env
# (mode 640, owner root:htxas) and fill in. Never commit the filled-in file.

HT_XAS_ENVIRONMENT=prod
# Port of the backend on 127.0.0.1 (nginx forwards /mail-in-xas/api/ to it).
HT_XAS_PORT=8008
HT_XAS_API_PREFIX=/mail-in-xas/api
HT_XAS_PUBLIC_ORIGIN=https://www-ssrl.slac.stanford.edu

HT_XAS_MONGODB_URI=mongodb://ht_xas_prod:<password>@<mongo-vm>:27017/?replicaSet=rs0&authSource=admin
HT_XAS_MONGODB_DB=ht_xas_prod

# ORCID production client (redirect URI
# https://www-ssrl.slac.stanford.edu/mail-in-xas/api/auth/orcid/callback).
HT_XAS_ORCID_BASE_URL=https://orcid.org
HT_XAS_ORCID_CLIENT_ID=<client id>
HT_XAS_ORCID_CLIENT_SECRET=<client secret>
# ORCID iDs that become Admin when they register (comma-separated).
HT_XAS_BOOTSTRAP_ADMIN_ORCIDS=<your ORCID iD>

# Never enable the dev login in production (the backend refuses to start).
HT_XAS_DEV_LOGIN_ENABLED=false

HT_XAS_SMTP_HOST=<smtp-relay>
HT_XAS_SMTP_PORT=25
HT_XAS_SMTP_STARTTLS=false
HT_XAS_MAIL_FROM_ADDRESS=<sender address>
