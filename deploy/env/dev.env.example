# Settings of the dev environment on the app VM: copy to /etc/ht-xas/dev.env (mode 640,
# owner root:htxas) and fill in. Never commit the filled-in file.

HT_XAS_ENVIRONMENT=dev
# Port of the backend on 127.0.0.1 (nginx forwards /mail-in-xas/dev/api/ to it).
HT_XAS_PORT=8009
HT_XAS_API_PREFIX=/mail-in-xas/dev/api
# How the browser reaches the VM directly (the dev environment is not public).
HT_XAS_PUBLIC_ORIGIN=http://<vm-internal-hostname>

HT_XAS_MONGODB_URI=mongodb://ht_xas_dev:<password>@<mongo-vm>:27017/?replicaSet=rs0&authSource=admin
HT_XAS_MONGODB_DB=ht_xas_dev

# Dev environment: fake login instead of ORCID.
HT_XAS_DEV_LOGIN_ENABLED=true
HT_XAS_BOOTSTRAP_ADMIN_ORCIDS=

# Mail: outside production everything goes only to HT_XAS_MAIL_DEV_REDIRECT.
HT_XAS_SMTP_HOST=<smtp-relay>
HT_XAS_SMTP_PORT=25
HT_XAS_SMTP_STARTTLS=false
HT_XAS_MAIL_FROM_ADDRESS=<sender address>
HT_XAS_MAIL_DEV_REDIRECT=<your address>
