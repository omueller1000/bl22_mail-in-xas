# Copy to .env and fill in. .env is ignored by git; never commit real values.

# local | dev | prod
HT_XAS_ENVIRONMENT=local

# Must match the public URL path (prod: /mail-in-xas/api, dev: /mail-in-xas/dev/api)
HT_XAS_API_PREFIX=/mail-in-xas/api

# Scheme + host the browser uses (prod: https://www-ssrl.slac.stanford.edu)
HT_XAS_PUBLIC_ORIGIN=http://localhost:5180

HT_XAS_MONGODB_URI=mongodb://<user>:<password>@<mongo-vm-fqdn>:27017/?replicaSet=rs0&authSource=admin
HT_XAS_MONGODB_DB=ht_xas_dev

# ORCID login. Sandbox for development, https://orcid.org in production.
# Leave the client id/secret empty to disable ORCID login.
HT_XAS_ORCID_BASE_URL=https://sandbox.orcid.org
HT_XAS_ORCID_CLIENT_ID=
HT_XAS_ORCID_CLIENT_SECRET=

# ORCID iDs that become Admin on registration/login (comma-separated)
HT_XAS_BOOTSTRAP_ADMIN_ORCIDS=

# Fake ORCID login for development. Never in prod (the backend refuses to start).
HT_XAS_DEV_LOGIN_ENABLED=true

# Test suite only (database ht_xas_test is wiped by tests). Better: put this line into
# backend/.env.test, which the tests read and git ignores.
# HT_XAS_TEST_MONGODB_URI=mongodb://<user>:<password>@<mongo-vm-fqdn>:27017/?replicaSet=rs0&authSource=admin
