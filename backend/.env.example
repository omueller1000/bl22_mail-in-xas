# Copy to .env and fill in. .env is ignored by git; never commit real values.

# local | dev | prod
HT_XAS_ENVIRONMENT=local

# Must match the public URL path (prod: /mail-in-xas/api, dev: /mail-in-xas/dev/api)
HT_XAS_API_PREFIX=/mail-in-xas/api

HT_XAS_MONGODB_URI=mongodb://<user>:<password>@<mongo-vm-fqdn>:27017/?replicaSet=rs0&authSource=admin
HT_XAS_MONGODB_DB=ht_xas_dev

# Fake ORCID login for development. Never in prod (the backend refuses to start).
HT_XAS_DEV_LOGIN_ENABLED=true

# Only for running the test suite against a real MongoDB (database ht_xas_test is wiped by tests)
# HT_XAS_TEST_MONGODB_URI=mongodb://<user>:<password>@<mongo-vm-fqdn>:27017/?replicaSet=rs0&authSource=admin
